# Template for environment variables

# AI provider used to generate AI swing analysis reports.
# Use "openai" for OpenAI models or "anthropic" for Claude models.
AI_PROVIDER=openai

# OpenAI API key used when AI_PROVIDER=openai.
OPENAI_API_KEY=

# Anthropic API key used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# News provider API key used to enrich AI reports with recent headlines.
NEWS_API_KEY=

# Model used by the AI report generator.
AI_MODEL=gpt-5.4-nano

# Monthly AI report allowance for Pro accounts.
AI_MONTHLY_REPORT_LIMIT_PRO=150

# Frontend fallback checkout URL for users who are NOT signed in.
# Signed-in users go through the backend /billing/create-checkout-session endpoint.
# Use a Stripe Payment Link or your hosted checkout URL.
NEXT_PUBLIC_STRIPE_PRO_CHECKOUT_URL=

# Stripe secret key (sk_test_... or sk_live_...). Used by the backend to create
# Checkout Sessions and verify webhooks.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...). Get this from the Stripe dashboard
# after creating a webhook endpoint pointing at /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Stripe Price ID for the Pro subscription (price_...).
STRIPE_PRO_PRICE_ID=

# Where Stripe redirects users after Checkout completes / is cancelled.
STRIPE_SUCCESS_URL=http://localhost:3000/ai-analyzer?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/pricing?checkout=cancelled

# Where Stripe redirects users after they finish managing their subscription
# in the Customer Portal (cancel, update payment method, etc.).
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/ai-analyzer

# ===== SEC EDGAR (free Insider Activity / Form 4 feed) =====
# EDGAR requires a descriptive User-Agent on every request (name + contact
# email). No API key is needed. Keep this identifying you/your service.
EDGAR_USER_AGENT=QuantorSignal contact@quantorsignal.com
# Minimum seconds between EDGAR requests (throttle < 10 req/sec fair-access cap).
EDGAR_MIN_REQUEST_INTERVAL=0.22
# Seconds to cache the ticker->CIK map (company_tickers.json).
EDGAR_CIK_MAP_TTL=86400
# Days to backfill on the first (empty-table) insider sync run.
EDGAR_BACKFILL_DAYS=7
# TTL (seconds) for the public /market/insider-activity response cache.
EDGAR_ACTIVITY_CACHE_TTL=300
