# Template for environment variables

# AI provider used to generate AI swing analysis reports.
# Use "openai" for OpenAI models or "anthropic" for Claude models.
AI_PROVIDER=openai

# OpenAI API key used when AI_PROVIDER=openai.
OPENAI_API_KEY=

# Anthropic API key used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# News provider API key used to enrich AI reports with recent headlines.
NEWS_API_KEY=

# Model used by the AI report generator.
AI_MODEL=gpt-5.4-nano

# Monthly AI report allowance for Pro accounts.
AI_MONTHLY_REPORT_LIMIT_PRO=150

# Frontend fallback checkout URL for users who are NOT signed in.
# Signed-in users go through the backend /billing/create-checkout-session endpoint.
# Use a Stripe Payment Link or your hosted checkout URL.
NEXT_PUBLIC_STRIPE_PRO_CHECKOUT_URL=

# Stripe secret key (sk_test_... or sk_live_...). Used by the backend to create
# Checkout Sessions and verify webhooks.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...). Get this from the Stripe dashboard
# after creating a webhook endpoint pointing at /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Stripe Price ID for the Pro subscription (price_...).
STRIPE_PRO_PRICE_ID=

# Where Stripe redirects users after Checkout completes / is cancelled.
STRIPE_SUCCESS_URL=http://localhost:3000/ai-analyzer?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/pricing?checkout=cancelled

# Where Stripe redirects users after they finish managing their subscription
# in the Customer Portal (cancel, update payment method, etc.).
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/ai-analyzer

# ===== EMAIL (Resend) =====
# API key from the Resend dashboard (re_...). Required for real sends.
RESEND_API_KEY=

# From address for all outbound email. The sending DOMAIN here (quantorsignal.com)
# MUST be verified in the Resend dashboard with SPF + DKIM records before mail
# will deliver. Format: "Display Name <address@your-verified-domain>".
EMAIL_FROM=QuantorSignal <alerts@quantorsignal.com>

# Optional Reply-To address. Leave empty to omit the header.
EMAIL_REPLY_TO=

# Master switch. Keep False until the domain is verified and the key is set.
# When False, all sends are skipped (and logged as "skipped") rather than sent.
EMAIL_ENABLED=false

# Public base URL used to build one-click unsubscribe links in emails.
# Must route /api/v1/* to this backend (directly or via proxy).
PUBLIC_APP_URL=https://quantorsignal.com

# ===== ELITE DAILY WATCHLIST AI DIGEST =====
# Master switch for the morning "Daily Watchlist AI Digest" email (Elite tier).
# When False, the scheduled job logs and exits. EMAIL_ENABLED must also be true
# for anything to actually send.
WATCHLIST_DIGEST_ENABLED=true

# Max watchlist tickers analyzed per user's digest (oldest first). Caps per-user
# LLM cost; any extra tickers are noted in the email as "showing N of M".
ELITE_DIGEST_MAX_STOCKS=10

# Global safety cap on fresh LLM report generations in a single digest run.
# Once exceeded, remaining users get digests built from cached reports only.
DIGEST_MAX_LLM_CALLS_PER_RUN=300
